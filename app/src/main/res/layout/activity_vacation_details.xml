<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/vacationDetailsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/vacationTitleEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/vacation_title"
            android:padding="12dp"
            android:importantForAutofill="no"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/vacationHotelEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/hotel"
            android:padding="12dp"
            android:importantForAutofill="no"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/vacationStartDateEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/start_date_mm_dd_yyyy"
            android:padding="12dp"
            android:importantForAutofill="no"
            android:inputType="date" />

        <EditText
            android:id="@+id/vacationEndDateEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/end_date_mm_dd_yyyy"
            android:padding="12dp"
            android:importantForAutofill="no"
            android:inputType="date" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveVacationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/primary_blue"
            android:text="@string/save_vacation"
            android:textColor="@color/white"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/setVacationAlertButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/primary_blue_light"
            android:text="@string/set_vacation_alert"
            android:textColor="@color/primary_blue_dark"
            app:cornerRadius="12dp"
            app:icon="@drawable/outline_add_alert_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/primary_blue_dark"
            app:strokeColor="@color/primary_blue"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/card_background"
            android:text="@string/share_vacation"
            android:textColor="@color/primary_blue_dark"
            app:cornerRadius="12dp"
            app:strokeColor="@color/outline_color"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteVacationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/danger_red_light"
            android:text="@string/delete"
            android:textColor="@color/danger_red"
            app:cornerRadius="12dp"
            app:icon="@drawable/baseline_delete_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/danger_red"
            app:strokeColor="@color/danger_red"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelVacationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@android:color/transparent"
            android:text="@string/cancel"
            android:textColor="@color/text_secondary"
            app:cornerRadius="12dp"
            app:strokeWidth="0dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/excursions"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addExcursionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/primary_blue"
            android:text="@string/add_excursion"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:icon="@drawable/outline_add_2_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/excursionRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</ScrollView>